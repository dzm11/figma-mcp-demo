{
  "defaultCollectionMode": {
    "Primitives": "Splash",
    "Semantic": "Splash"
  },
  "cssSelectorByModeName": {
    "Splash": ":root",
    "Default": ":root, [data-theme=\"default\"]",
    "Light": ":root",
    "Dark": "[data-theme=\"dark\"]"
  },
  "valueFormatting": {
    "baseFontSizePx": 16,
    "colorFormat": "oklch",
    "dimensionFormat": "rem",
    "lineHeightFormat": "px"
  },
  "floatUnitRules": [
    {
      "match": "^spacing-",
      "unit": "px"
    },
    {
      "match": "^h-",
      "unit": "px"
    },
    {
      "match": "^w-",
      "unit": "px"
    },
    {
      "match": "^radius-",
      "unit": "px"
    },
    {
      "match": "^border-radius-",
      "unit": "px"
    },
    {
      "match": "^border-weight-",
      "unit": "px"
    },
    {
      "match": "^font-size-",
      "unit": "px"
    },
    {
      "match": "^line-height-",
      "unit": "px"
    },
    {
      "match": "^letter-spacing-",
      "unit": "px"
    },
    {
      "match": "^border-width-",
      "unit": "px"
    },
    {
      "match": "^size-",
      "unit": "px"
    },
    {
      "match": "^opacity-",
      "unit": ""
    },
    {
      "match": "^z-index-",
      "unit": ""
    }
  ],
  "output": {
    "sourceJson": "tokens/tokens.source.json",
    "cssFile": "src/styles/tokens.css",
    "typographyCssFile": "src/styles/typography.css"
  }
}
