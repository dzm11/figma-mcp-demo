# Copy this file to .env.local and fill in your values.

# ── Figma Code Connect (existing) ────────────────────────────────────────
# Used by `npm run figma:publish` and `figma:publish:dry`.
FIGMA_ACCESS_TOKEN=PASTE_YOUR_FIGMA_ACCESS_TOKEN_HERE

# ── Token sync pipeline (new) ─────────────────────────────────────────────
# FIGMA_TOKEN can be set to the same value as FIGMA_ACCESS_TOKEN above.
# Used by `npm run tokens:pull`, `tokens:sync`, and `tokens:pr`.
FIGMA_TOKEN=PASTE_YOUR_FIGMA_PERSONAL_ACCESS_TOKEN_HERE

# The key from your Figma file URL:
# https://www.figma.com/design/<FILE_KEY>/...
FIGMA_FILE_KEY=H3scHHO8gzcKecmO2Sa9aN

# ── PR automation (tokens:pr only) ───────────────────────────────────────
# Branch that token sync PRs target.
BASE_BRANCH=main

# Prefix for auto-created sync branches (timestamp appended automatically).
TOKENS_BRANCH_PREFIX=chore/tokens-sync
